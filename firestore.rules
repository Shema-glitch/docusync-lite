
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: Can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Documents: Complex rules for collaboration
    match /documents/{documentId} {
      
      // Helper function to get the role of the requesting user
      function getRole() {
        return resource.data.members[request.auth.uid].role;
      }
      
      // Helper function to check if the requesting user is the owner
      function isOwner() {
        return getRole() == 'owner';
      }
      
      // Helper function to check if the requesting user is an editor or owner
      function isEditor() {
        let role = getRole();
        return role == 'editor' || role == 'owner';
      }

      // READ: Allow if the user is listed in the members map.
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      
      // CREATE: Allow if the user is authenticated and is setting themselves as the 'owner'.
      allow create: if request.auth != null && request.resource.data.members[request.auth.uid].role == 'owner';

      // UPDATE: Allow if the user is an owner or editor.
      // Owners have full control, while editors cannot change the member list.
      allow update: if request.auth != null && (isEditor() && request.resource.data.keys().diff(resource.data.keys()).hasOnly(['updatedAt', 'trashedAt', 'isFavorite', 'reminderDate', 'title', 'description', 'category', 'tags']) || isOwner());
      
      // DELETE: Only the owner can delete a document.
      allow delete: if request.auth != null && isOwner();
    }
  }
}
