rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isOwner(docId) {
      return get(/databases/$(database)/documents/documents/$(docId)).data.members[request.auth.uid].role == 'owner';
    }
    
    function isEditor(docId) {
        let role = get(/databases/$(database)/documents/documents/$(docId)).data.members[request.auth.uid].role;
        return role == 'owner' || role == 'editor';
    }
    
    function isViewer(docId) {
        return request.auth.uid in get(/databases/$(database)/documents/documents/$(docId)).data.members;
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /documents/{docId} {
      // CREATE: Allow if the user is creating a document and setting themselves as the owner.
      allow create: if request.auth.uid != null &&
                      request.resource.data.members[request.auth.uid].role == 'owner' &&
                      request.resource.data.members.size() == 1;

      // READ: Allow if the user is in the members map.
      allow get: if isViewer(docId);
      allow list: if request.auth.uid != null;

      // UPDATE: Allow if user is an owner/editor, with restrictions
      allow update: if request.auth.uid != null && isEditor(docId) &&
                     // Protect critical fields from being changed by editors
                     (isOwner(docId) || !('members' in request.resource.data));
    }
  }
}