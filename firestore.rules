
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write to their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;

      // Activity logs are private to each user.
      match /activity/{activityId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Rules for the documents collection
    match /documents/{documentId} {
      // Allow a user to list documents ONLY IF the query is scoped to their own documents.
      // This rule enforces that the client-side query must be in the form of:
      // where('members.USER_ID', 'in', ['owner', 'editor', 'viewer'])
      allow list: if request.auth != null && request.query.where[0][0] == 'members.' + request.auth.uid;

      // Allow read on a single document if the user is a member.
      allow read: if request.auth != null && resource.data.members.keys().hasAny([request.auth.uid]);

      // Allow create if the user is creating it for themselves as an owner.
      allow create: if request.auth != null
                    && request.resource.data.members[request.auth.uid].role == 'owner';

      // Allow update if the user is an owner or editor.
      allow update: if request.auth != null
                    && (resource.data.members[request.auth.uid].role == 'owner'
                        || resource.data.members[request.auth.uid].role == 'editor');

      // Allow delete only if the user is the owner.
      allow delete: if request.auth != null && resource.data.members[request.auth.uid].role == 'owner';
    }
  }
}
